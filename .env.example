# Copy this file to .env.local for local dev, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables. NEVER commit real values.
#
# Find both in Supabase -> Project Settings -> API.
# These are server-only (used by /api/*.ts). Do NOT add a VITE_ prefix.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Google Calendar -> Settings -> your calendar -> Integrate calendar ->
# "Secret address in iCal format". When set, all-day and 6+ hour events block dates on the site.
GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/YOUR-CALENDAR/private-YOUR-KEY/basic.ics

# Guest guide (private page at /guide/<GUIDE_SECRET>). Server-only.
# GUIDE_SECRET: a long random string. Make one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
GUIDE_SECRET=replace-with-a-long-random-string
# Optional: Google Sheet -> File -> Share -> Publish to web -> pick the Guide tab -> CSV -> copy the link.
GUIDE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR-SHEET/pub?gid=0&single=true&output=csv
